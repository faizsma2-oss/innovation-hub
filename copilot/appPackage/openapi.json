{
  "openapi": "3.0.3",
  "info": {
    "title": "Innovation Hub for Copilot",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://innovation-hub-demo.onrender.com"
    }
  ],
  "paths": {
    "/api/copilot/companies": {
      "get": {
        "tags": [
          "companies"
        ],
        "summary": "List supplier companies the innovation team is working with, with stage and next step",
        "operationId": "listCompanies",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Search"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "hubKey": []
          }
        ]
      }
    },
    "/api/copilot/companies/{company_id}": {
      "get": {
        "tags": [
          "companies"
        ],
        "summary": "Where the team stands with one supplier: stage, contacts, emails, meetings, actions and notes",
        "operationId": "getCompanyStatus",
        "parameters": [
          {
            "name": "company_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Company Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "hubKey": []
          }
        ]
      }
    },
    "/api/copilot/overdue": {
      "get": {
        "tags": [
          "companies"
        ],
        "summary": "What is overdue or slipping: actions, unanswered supplier emails, missing meeting notes, pilots and check-ins",
        "description": "The same rules as the Today panel, without the 'coming up' items. Optionally for one owner.",
        "operationId": "listOverdue",
        "parameters": [
          {
            "name": "owner",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Owner"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "hubKey": []
          }
        ]
      }
    },
    "/api/copilot/decisions": {
      "get": {
        "tags": [
          "companies"
        ],
        "summary": "Decisions waiting on people: business cases, pilot decisions and employee-requested reviews",
        "description": "The same rules as the weekly report. Says who decides; the Hub doesn't yet know who is asking.",
        "operationId": "listDecisionsNeeded",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "hubKey": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "hubKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      }
    }
  }
}